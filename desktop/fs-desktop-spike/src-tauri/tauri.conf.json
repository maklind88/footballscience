{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FS Desktop Architecture Spike",
  "version": "0.0.1",
  "identifier": "xyz.footballscience.desktop.spike",
  "build": {
    "frontendDist": "../candidates"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FS Desktop Architecture Spike — Bundled",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "url": "bundled/index.html"
      }
    ],
    "security": {
      "capabilities": ["bundled"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
