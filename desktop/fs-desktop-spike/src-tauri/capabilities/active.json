{
  "identifier": "active",
  "description": "Exact active signed-shell commands, scoped to the native active window only.",
  "windows": ["main"],
  "platforms": ["macOS", "windows"],
  "permissions": [
    "allow-runtime-info",
    "allow-bootstrap-status",
    "allow-bootstrap-update",
    "allow-open-recovery",
    "allow-session-authority",
    "allow-auth-status",
    "allow-auth-sign-in",
    "allow-auth-refresh",
    "allow-auth-reset-password",
    "allow-auth-sign-out",
    "allow-api-request",
    "allow-session-read",
    "allow-session-sync-status",
    "allow-session-sync",
    "allow-session-operation",
    "allow-record-probe"
  ]
}
