{
  "identifier": "active",
  "description": "Exact active signed-shell commands, scoped to the native active window only.",
  "windows": ["main"],
  "platforms": ["macOS", "windows"],
  "permissions": [
    "allow-runtime-info",
    "allow-bootstrap-status",
    "allow-bootstrap-update",
    "allow-open-recovery",
    "allow-session-authority",
    "allow-session-read",
    "allow-session-operation",
    "allow-record-probe"
  ]
}
